{
  "name": "document-verdict",
  "private": true,
  "version": "0.1.0",
  "description": "MVP «AI-вердикт по документам»: клиентское маскирование ПДн + вердикт-движок",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/masker/tsconfig.json && tsc -p apps/server/tsconfig.json",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "node scripts/extract.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "audit": "node scripts/audit-mask.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:copy": "node scripts/check-copy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.9.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.1.1"
  }
}
